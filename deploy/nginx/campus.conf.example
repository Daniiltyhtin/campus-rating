# /etc/nginx/sites-available/campus.conf — замените campus.example.ru на домен стенда,
# WEB_PORT — на значение WEB_PORT из deploy/server.env.
# Сертификат выпускается до этого файла — порядок в deploy/README.md, шаг «nginx и сертификат».

# Ограничиваются только POST: пустой ключ limit_req не учитывает, GET /api/v1/auth/email/status опрашивается экраном.
map $request_method $campus_auth_client {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $campus_auth_client zone=campus_login:10m rate=60r/m;
limit_req_zone $campus_auth_client zone=campus_auth:10m rate=10r/m;

server {
    listen 80;
    server_name campus.example.ru;
    server_tokens off;
    return 301 https://$host$request_uri;
}

server {
    # http2 в listen, а не «http2 on»: директива появилась только в nginx 1.25.1.
    listen 443 ssl http2;
    server_name campus.example.ru;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/campus.example.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/campus.example.ru/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 12m;
    limit_req_status 429;

    location = /api/v1/auth/login {
        limit_req zone=campus_login burst=60 nodelay;
        proxy_pass http://127.0.0.1:WEB_PORT;
        proxy_hide_header Strict-Transport-Security;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }

    location ~ ^/api/v1/auth/(register/|email/|password) {
        limit_req zone=campus_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:WEB_PORT;
        proxy_hide_header Strict-Transport-Security;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }

    error_page 429 = @rate_limited;
    location @rate_limited {
        default_type application/problem+json;
        return 429 '{"type":"about:blank","title":"Too Many Requests","status":429,"code":"RATE_LIMITED","detail":"Слишком много попыток. Подождите минуту и попробуйте снова."}';
    }

    location / {
        proxy_pass http://127.0.0.1:WEB_PORT;
        proxy_hide_header Strict-Transport-Security;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
