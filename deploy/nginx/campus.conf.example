# /etc/nginx/sites-available/campus.conf — замените campus.example.ru на домен стенда.
# Сертификат: sudo certbot --nginx -d campus.example.ru (или certonly и пути ниже).

server {
    listen 80;
    server_name campus.example.ru;
    return 301 https://$host$request_uri;
}

server {
    # http2 в listen, а не «http2 on»: директива появилась только в nginx 1.25.1.
    listen 443 ssl http2;
    server_name campus.example.ru;

    ssl_certificate /etc/letsencrypt/live/campus.example.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/campus.example.ru/privkey.pem;

    client_max_body_size 12m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
