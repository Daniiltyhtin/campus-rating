# Скопируйте в deploy/server.env, заполните и запускайте:
# docker compose --env-file deploy/server.env -f docker-compose.yml -f docker-compose.server.yml up -d --build --wait
# Файл deploy/server.env не коммитится.

# Обязательные
POSTGRES_PASSWORD=
# off — вход сразу после регистрации; required — только с настроенным SMTP
EMAIL_VERIFICATION=off
# Адрес стенда для ссылок в письмах
CAMPUS_PUBLIC_URL=https://

# Порт web на 127.0.0.1 для nginx хоста (по умолчанию 8080)
WEB_PORT=8080

# SMTP Яндекса — только если нужна почта. Пароль — пароль приложения, не пароль аккаунта.
# Без этих строк письма не отправляются, EMAIL_VERIFICATION должен быть off.
# SPRING_MAIL_HOST=smtp.yandex.ru
# SPRING_MAIL_PORT=465
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=true
# CAMPUS_MAIL_FROM=
